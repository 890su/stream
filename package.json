{
  "name": "stream",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "baileys": "7.0.0-rc14"
  },
  "pnpm": {
    "packageExtensions": {
      "baileys@7.0.0-rc14": {
        "peerDependenciesMeta": {
          "sharp": {
            "optional": true
          }
        }
      }
    }
  }
}
