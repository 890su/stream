[Unit]
Description=Stream nightly backup (consistent database snapshot + referenced media)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/stream/app/deploy
EnvironmentFile=/srv/stream/.env
# VACUUM INTO reads a consistent snapshot while the server keeps running.
ExecStart=/usr/bin/docker compose run --rm --no-deps stream node --disable-warning=ExperimentalWarning src/backup.ts /backups
# Keep 30 days of dated snapshots.
ExecStartPost=/usr/bin/find /srv/stream/backups -mindepth 1 -maxdepth 1 -type d -mtime +30 -exec rm -rf {} +
