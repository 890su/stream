#!/usr/bin/env python3
# Desktop notification daemon of the agent desktop: owns org.freedesktop.Notifications on the session bus and appends
# every notification (app, title, text, time) as one JSON line to ~/inbox/notifications.jsonl. Nothing is shown
# on screen. Readers (the Viber source of Stream) follow the file.
import json, os, time
import dbus, dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

INBOX = os.path.expanduser('~/inbox')
LOG = os.path.join(INBOX, 'notifications.jsonl')
NAME = 'org.freedesktop.Notifications'


def plain(value):
    if isinstance(value, (dbus.String, str)): return str(value)
    if isinstance(value, (dbus.Boolean, bool)): return bool(value)
    if isinstance(value, (dbus.Int32, dbus.UInt32, dbus.Byte, dbus.Int64, int)): return int(value)
    return None  # images and other binary hints are skipped


class Notifications(dbus.service.Object):
    def __init__(self, bus):
        super().__init__(bus, '/org/freedesktop/Notifications')
        self.next_id = 1

    @dbus.service.method(NAME, out_signature='as')
    def GetCapabilities(self):
        return ['body', 'actions']

    @dbus.service.method(NAME, out_signature='ssss')
    def GetServerInformation(self):
        return ('agent-notify-log', 'stream', '1', '1.2')

    @dbus.service.method(NAME, in_signature='susssasa{sv}i', out_signature='u')
    def Notify(self, app, replaces_id, icon, summary, body, actions, hints, timeout):
        nid = int(replaces_id) or self.next_id
        self.next_id = max(self.next_id, nid) + 1
        record = {'ts': time.strftime('%Y-%m-%dT%H:%M:%S%z'), 'id': nid, 'app': str(app), 'summary': str(summary),
                  'body': str(body), 'hints': {str(k): plain(v) for k, v in hints.items() if plain(v) is not None}}
        with open(LOG, 'a', encoding='utf-8') as out:
            out.write(json.dumps(record, ensure_ascii=False) + '\n')
        return nid

    @dbus.service.method(NAME, in_signature='u')
    def CloseNotification(self, nid):
        self.NotificationClosed(nid, 3)

    @dbus.service.signal(NAME, signature='uu')
    def NotificationClosed(self, nid, reason):
        pass


if __name__ == '__main__':
    os.makedirs(INBOX, exist_ok=True)
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    name = dbus.service.BusName(NAME, bus)
    Notifications(bus)
    GLib.MainLoop().run()
