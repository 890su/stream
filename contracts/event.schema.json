                    },
                    "executors": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^(?=.{1,120}$)(?:me|ai|system|tg:\\d+|tel:\\+\\d+|group:tg:-?\\d+|name:\\S.*)$"
                      }
                    },
                    "controller": {
                      "type": [
