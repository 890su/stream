{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stream/contracts/event/v1",
  "title": "Event",
  "description": "Immutable journal entry. Written by sources; never updated or deleted.",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "source",
    "author",
    "ts",
    "kind",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Generated by the client (phone) so that retries are idempotent."
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "description": "Where the event came from. Known values: app, share, system, analyst, email, telegram, viber, whatsapp, android_notifications, android_phone.",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "author": {
      "type": "string",
      "description": "'me' for the owner, 'system' for the pipeline, 'contact:<id>' for external people.",
      "pattern": "^(me|system|analyst|contact:.+)$"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened on the device (client clock)."
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set by the server on write."
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "voice",
        "photo",
        "file",
        "link",
        "question",
        "answer",
        "correction",
        "task_change",
        "triage_result",
        "project_change",
        "contact_change",
        "counterparty_change",
        "proposal",
        "action_result",
        "system",
        "call",
        "sms"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "media_id",
              "mime"
            ],
            "properties": {
              "media_id": {
                "type": "string"
              },
              "mime": {
                "type": "string"
              },
              "duration_s": {
                "type": "number",
                "minimum": 0
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "ref": {
          "type": "object",
          "description": "Reference to another record for correction / task_change / answer / action_result.",
          "properties": {
            "type": {
              "enum": [
                "event",
                "interpretation",
                "task",
                "project",
                "person",
                "counterparty",
                "action",
                "question"
              ]
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "description": "Tags chosen by the owner at capture time; a hint for interpretation. Optional, added in v1 without breaking readers.",
          "items": {
            "type": "string",
            "pattern": "^#[\\p{L}0-9_-]+$"
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "triage": {
              "type": "object",
              "description": "On kind: triage_result. Messages handled as context without a task.",
              "required": ["processor", "conversation_only"],
              "additionalProperties": false,
              "properties": {
                "processor": { "type": "string", "pattern": "^\\S+$" },
                "conversation_only": { "type": "array", "items": { "type": "string", "format": "uuid" } },
                "proposals": {
                  "type": "array",
                  "description": "Changes of existing tasks the triage proposes; the owner accepts, moves or rejects each (docs/plans/2026-11-21-ai-proposals-design.md).",
                  "items": {
                    "type": "object",
                    "required": ["id", "task_id", "message_ids", "reason", "confidence", "alternatives", "change"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "format": "uuid" },
                      "task_id": { "type": "string", "format": "uuid" },
                      "message_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } },
                      "reason": { "type": "string", "maxLength": 500 },
                      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                      "alternatives": { "type": "array", "items": { "type": "string", "format": "uuid" } },
                      "change": { "type": "object", "description": "The task_change data applied when the owner accepts." }
                    }
                  }
                }
              }
            },
            "call": {
              "type": "object",
              "description": "A phone call from the Android companion (CONCEPT.md 8.1). Only on kind: call.",
              "required": [
                "direction",
                "started_at"
              ],
              "additionalProperties": false,
              "properties": {
                "direction": {
                  "enum": [
                    "in",
                    "out",
                    "missed",
                    "rejected",
                    "unknown"
                  ]
                },
                "number": {
                  "type": "string",
                  "description": "As the phone gave it; empty for a hidden number."
                },
                "name": {
                  "type": "string",
                  "description": "Name from the phone's contacts, if any."
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "duration_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "sim": {
                  "type": "string"
                }
              }
            },
            "sms": {
              "type": "object",
              "description": "An SMS from the Android companion (CONCEPT.md 8.1); its text is payload.text. Only on kind: sms.",
              "required": [
                "direction",
                "number",
                "sent_at"
              ],
              "additionalProperties": false,
              "properties": {
                "direction": {
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "number": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "sent_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "sim": {
                  "type": "string"
                }
              }
            },
            "continuation": {
              "type": "object",
              "description": "Owner's answer to the 'continuation' suggestion at capture (CONCEPT.md 2.5): does this message continue `target`? Kept when declined too, as training data.",
              "required": [
                "target",
                "on"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string",
                  "format": "uuid"
                },
                "on": {
                  "type": "boolean"
                }
              }
            },
            "tagging": {
              "type": "object",
              "description": "Owner feedback on tag suggestions at capture (CONCEPT.md 2.2): training data for interpretation. auto and owner_on are subsets of payload.tags; owner_off is disjoint from it.",
              "required": [
                "engine",
                "suggested",
                "auto",
                "owner_on",
                "owner_off"
              ],
              "additionalProperties": false,
              "properties": {
                "engine": {
                  "type": "string",
                  "description": "Suggester name and version, e.g. local-v1."
                },
                "suggested": {
                  "type": "array",
                  "description": "Shown and left inactive.",
                  "items": {
                    "type": "string",
                    "pattern": "^#[\\p{L}0-9_-]+$"
                  }
                },
                "auto": {
                  "type": "array",
                  "description": "Switched on by the suggester and kept.",
                  "items": {
                    "type": "string",
                    "pattern": "^#[\\p{L}0-9_-]+$"
                  }
                },
                "owner_on": {
                  "type": "array",
                  "description": "Switched on by the owner.",
                  "items": {
                    "type": "string",
                    "pattern": "^#[\\p{L}0-9_-]+$"
                  }
                },
                "owner_off": {
                  "type": "array",
                  "description": "Switched on by the suggester, switched off by the owner.",
                  "items": {
                    "type": "string",
                    "pattern": "^#[\\p{L}0-9_-]+$"
                  }
                }
              }
            },
            "telegram": {
              "type": "object",
              "description": "A message from a Telegram account gateway (CONCEPT.md 8.2). Only with source: telegram.",
              "required": [
                "account",
                "chat_id",
                "chat_type",
                "message_id",
                "sent_at"
              ],
              "additionalProperties": false,
              "properties": {
                "account": {
                  "type": "string",
                  "pattern": "^[a-z]{2,8}$",
                  "description": "Account key from registry/telegram.json, e.g. by, pl."
                },
                "chat_id": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,20}$"
                },
                "chat_type": {
                  "enum": [
                    "private",
                    "group"
                  ]
                },
                "chat_title": {
                  "type": "string"
                },
                "from_id": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,20}$"
                },
                "from_name": {
                  "type": "string"
                },
                "message_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "sent_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reply_to_message_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "album_id": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,20}$"
                },
                "forward": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date"
                  ],
                  "properties": {
                    "from_id": {
                      "type": "string",
                      "pattern": "^-?[0-9]{1,20}$"
                    },
                    "from_name": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "media_skipped": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "reason": {
                      "enum": [
                        "too_large",
                        "unsupported",
                        "failed"
                      ]
                    },
                    "mime": {
                      "type": "string"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "viber": {
              "type": "object",
              "description": "A Viber message read on the agent desktop (deploy/DESKTOP.md): the sender as Viber shows it, the phone when Viber shows it (contacts; hidden for people not in contacts). Only with source: viber.",
              "required": [
                "chat",
                "received_at"
              ],
              "additionalProperties": false,
              "properties": {
                "chat": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "The chat's name in Viber (the sender, or the group)."
                },
                "phone": {
                  "type": "string",
                  "pattern": "^\\+[0-9]{6,15}$"
                },
                "group": {
                  "type": "boolean"
                },
                "received_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "whatsapp": {
              "type": "object",
              "description": "A WhatsApp message received by the linked device (docs/plans/2026-11-20-whatsapp-baileys-design.md): the account, the chat as WhatsApp names it, its address (a phone address or an anonymous LID), the phone when known. Only with source: whatsapp.",
              "required": [
                "account",
                "chat",
                "jid",
                "received_at"
              ],
              "additionalProperties": false,
              "properties": {
                "account": {
                  "type": "string",
                  "pattern": "^[a-z]{2,8}$"
                },
                "chat": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "The sender's name in WhatsApp, else the phone or the address."
                },
                "jid": {
                  "type": "string",
                  "pattern": "^[0-9]+@(s\\.whatsapp\\.net|lid)$"
                },
                "phone": {
                  "type": "string",
                  "pattern": "^\\+[0-9]{6,15}$"
                },
                "received_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "outbound": {
              "type": "object",
              "description": "The owner's reply to be sent outside (CONCEPT.md 8.2): writing it creates a class C action for the connector. Only on kind: text by me. Telegram: chat_id is the chat's number; Viber (connector viber) and WhatsApp (connectors whatsapp_*): the phone.",
              "required": [
                "connector",
                "chat_id"
              ],
              "additionalProperties": false,
              "properties": {
                "connector": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "chat_id": {
                  "type": "string",
                  "pattern": "^(-?[0-9]{1,20}|\\+[0-9]{6,15})$"
                },
                "chat_title": {
                  "type": "string"
                },
                "reply_to_message_id": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "action": {
              "type": "object",
              "description": "On kind: action_result — a change of an action's status (payload.ref → the action).",
              "required": [
                "status",
                "connector"
              ],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "proposed",
                    "approved",
                    "running",
                    "done",
                    "failed",
                    "rejected"
                  ]
                },
                "connector": {
                  "type": "string"
                },
                "source_event": {
                  "type": "string",
                  "format": "uuid"
                },
                "external_id": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              }
            },
            "system": {
              "type": "object",
              "description": "On kind: system — a state change of a source or connector (System screen, CONCEPT.md 5).",
              "required": [
                "source",
                "state"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "state": {
                  "enum": [
                    "ok",
                    "silent",
                    "login_required",
                    "error",
                    "off"
                  ]
                },
                "previous": {
                  "enum": [
                    "ok",
                    "silent",
                    "login_required",
                    "error",
                    "off",
                    "unknown"
                  ]
                }
              }
            },
            "project": {
              "type": "object",
              "description": "On kind: project_change (payload.ref -> {type: project, id}). Creates or changes a project (CONCEPT.md 2.11); the project is the fold of these events.",
              "required": ["op"],
              "additionalProperties": false,
              "properties": {
                "op": { "enum": ["create", "update"] },
                "title": { "type": "string", "pattern": "^\\S[^\\n]{0,119}$" },
                "parent": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
                "kind": { "enum": ["stream", "goal"] },
                "sources": {
                  "type": "array",
                  "description": "Sources whose new tasks go to this project by default (CONCEPT.md 2.11): tg:<account>, phone, me.",
                  "items": { "type": "string", "pattern": "^(?:tg:[a-z]{2,10}|phone|me)$" }
                },
                "status": { "enum": ["active", "paused", "done", "archived"] },
                "scope": { "type": "string", "maxLength": 500, "description": "What belongs to this project, in the owner's words: the triage puts a task here only when it fits (owner, 2026-11-20)." },
                "sections": {
                  "type": "array",
                  "description": "The project's sections in order; role next - its next actions (shown in Сегодня), ideas - its backlog.",
                  "items": {
                    "type": "object",
                    "required": ["id", "title"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "pattern": "^[0-9a-z-]{1,64}$" },
                      "title": { "type": "string", "pattern": "^\\S[^\\n]{0,59}$" },
                      "role": { "enum": ["next", "ideas"] }
                    }
                  }
                }
              }
            },
            "contact": {
              "type": "object",
              "description": "On kind: contact_change (payload.ref -> {type: person, id}). Creates or changes a person of the directory (contacts design 3); the person is the fold of these events.",
              "required": ["op"],
              "additionalProperties": false,
              "properties": {
                "op": { "enum": ["create", "update"] },
                "name": { "type": "string", "pattern": "^\\S[^\\n]{0,119}$" },
                "phones": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
                "emails": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
                "telegram": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
                "addresses": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
                "note": { "type": "string", "maxLength": 1000 },
                "status": { "enum": ["active", "deleted"] },
                "roles": {
                  "type": "array",
                  "description": "Job titles at counterparties: the link person - counterparty.",
                  "items": {
                    "type": "object", "required": ["counterparty", "title"], "additionalProperties": false,
                    "properties": { "counterparty": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }, "title": { "type": "string", "maxLength": 60 } }
                  }
                }
              }
            },
            "counterparty": {
              "type": "object",
              "description": "On kind: counterparty_change (payload.ref -> {type: counterparty, id}). An organization or an address of a private client (contacts design 3).",
              "required": ["op"],
              "additionalProperties": false,
              "properties": {
                "op": { "enum": ["create", "update"] },
                "kind": { "enum": ["org", "address"] },
                "title": { "type": "string", "pattern": "^\\S[^\\n]{0,119}$" },
                "address": { "type": "string", "maxLength": 200 },
                "side": { "type": ["string", "null"], "enum": ["pl", "by", null] },
                "tax_id": { "type": "string", "maxLength": 30 },
                "status": { "enum": ["active", "archived"] }
              }
            },
            "task": {
              "type": "object",
              "description": "On kind: task_change (payload.ref → {type: task, id}). Creates or changes a task (CONCEPT.md 2.8); the task is the fold of these events.",
              "required": [
                "op"
              ],
              "additionalProperties": false,
              "properties": {
                "op": {
                  "enum": [
                    "create",
                    "update"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "inbox",
                    "todo",
                    "doing",
                    "waiting",
                    "done",
                    "cancelled",
                    "review",
                    "deferred"
                  ]
                },
                "assignee": {
                  "enum": [
                    "me",
                    "ai",
                    "system",
                    "person"
                  ]
                },
                "person": {
                  "type": "string",
                  "description": "Who, when assignee is person."
                },
                "template": {
                  "type": "string"
                },
                "due": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "add": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "description": "Messages that belong to the task from now on."
                },
                "remove": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "description": "Messages that no longer belong to it."
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0
                },
                "note": {
                  "type": "string"
                },
                "resume_note": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Where the owner stopped when the task was paused (task manager spec 5.4); '' clears it."
                },
                "processor": {
                  "type": "string",
                  "description": "Name and version of the handler that made the change (absent for the owner)."
                },
                "reason": {
                  "type": "string",
                  "maxLength": 500,
                  "description": "Why the handler made this change, one line (the AI log)."
                },
                "proposal": {
                  "type": "string",
                  "format": "uuid",
                  "description": "The triage proposal this owner change answers (triage_result proposals)."
                },
                "unconfirmed": {
                  "type": "boolean",
                  "description": "Made by the AI and waiting for the owner (true), or confirmed (false); absent — a real task (design 2026-11-21)."
                },
                "proposed": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "done",
                    null
                  ],
                  "description": "A handler thinks the work is finished and asks the owner (CONCEPT.md 2.9); null withdraws the question."
                },
                "project": { "type": ["string", "null"], "description": "The one project the task lives in (CONCEPT.md 2.11); null - Входящие.", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
                "section": { "type": ["string", "null"], "pattern": "^[0-9a-z-]{1,64}$" },
                "project_options": {
                  "type": "array",
                  "description": "Projects the triage hesitates between: the task asks «В какой проект?» (CONCEPT.md 2.11).",
                  "items": { "type": "string", "format": "uuid" }
                },
                "items_add": {
                  "type": "array",
                  "description": "Checklist items added to the task (CONCEPT.md 2.8): id and one line of text.",
                  "items": {
                    "type": "object",
                    "required": ["id", "text"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "pattern": "^[0-9a-z-]{1,64}$" },
                      "text": { "type": "string", "pattern": "^\\S[^\\n]{0,199}$" }
                    }
                  }
                },
                "items_set": {
                  "type": "array",
                  "description": "Checklist items ticked, unticked or reworded.",
                  "items": {
                    "type": "object",
                    "required": ["id"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "pattern": "^[0-9a-z-]{1,64}$" },
                      "done": { "type": "boolean" },
                      "text": { "type": "string", "pattern": "^\\S[^\\n]{0,199}$" }
                    }
                  }
                },
                "items_remove": {
                  "type": "array",
                  "description": "Checklist items taken out (moved to a task of their own or dropped).",
                  "items": { "type": "string", "pattern": "^[0-9a-z-]{1,64}$" }
                },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "description": "Other tasks the added messages may belong to: the owner is asked on the message (CONCEPT.md 2.8)."
                },
                "counterparty": { "type": ["string", "null"], "description": "The counterparty of the task (contacts design 6).", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
                "counterparty_options": { "type": "array", "description": "When the triage is unsure: up to three counterparties to choose from.", "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" } },
                "counterparty_hint": { "type": ["string", "null"], "maxLength": 120, "description": "The triage's name for a new counterparty: a firm or an address." },
