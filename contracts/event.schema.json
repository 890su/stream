                "muted": { "type": "array", "description": "Participants switched off in the task card: answers from the task do not go to them (2026-11-19).", "items": { "type": "string", "pattern": "^(?=.{1,120}$)(?:me|ai|system|tg:\\d+|tel:\\+\\d+|group:tg:-?\\d+|name:\\S.*)$" } },
                "report": {
                  "type": "object",
