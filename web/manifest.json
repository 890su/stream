{
  "id": "/",
  "name": "Stream — личная лента",
  "short_name": "Stream",
  "lang": "ru",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Голос",
      "url": "/?mode=voice"
    },
    {
      "name": "Текст",
      "url": "/?mode=text"
    },
    {
      "name": "Фото",
      "url": "/?mode=photo"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "audio/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "user_preferences": {
    "color_scheme": {
      "dark": {
        "theme_color": "#17212b",
        "background_color": "#17212b"
      }
    }
  },
  "theme_colors": [
    {
      "color": "#17212b",
      "media": "(prefers-color-scheme: dark)"
    },
    {
      "color": "#ffffff"
    }
  ],
  "background_colors": [
    {
      "color": "#17212b",
      "media": "(prefers-color-scheme: dark)"
    },
    {
      "color": "#ffffff"
    }
  ]
}
