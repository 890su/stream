# runtime data: database and media
data/

# dependencies and builds
node_modules/
dist/
build/
coverage/
.venv/
venv/
__pycache__/
*.pyc

# secrets
.env
.env.*
!.env.example

# local
.library/
.tmp/
.cache/
.safe/
*.log

# archive: superseded decisions, finished plans, old Done items — local only, not indexed (.aiignore)
archive/

# tool scratch (design critiques, agent runs)
.impeccable/
.superpowers/

# personal source notes: kept locally, repository is public
attachments/

# real owner messages with client and family data: local only, repository is public
golden/*.local.jsonl

# content, never system: any local data file (CONTEXT.md, rule 15)
*.local.*

# Android companion (android/): build output, local SDK path, signing key and its password
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
android/local.properties
android/keystore.local.properties
*.jks
*.keystore
*.apk
