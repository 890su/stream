{
  "version": 1,
  "filters": [
    { "id": "mine", "title": "Мои", "all": [
      { "field": "status", "op": "in", "value": ["inbox", "todo", "doing", "waiting", "review", "deferred"] },
      { "field": "filed", "op": "eq", "value": false },
      { "field": "involves_me", "op": "eq", "value": true },
      { "any": [
        { "field": "role.executors", "op": "includes", "value": "me" },
        { "all": [{ "field": "role.executors", "op": "empty" }, { "field": "role.responsible", "op": "eq", "value": "me" }] }
      ] }
    ] },
    { "id": "new", "title": "Новые", "all": [
      { "field": "status", "op": "eq", "value": "inbox" },
      { "field": "involves_me", "op": "eq", "value": true }
    ] },
    { "id": "control", "title": "На контроле", "all": [
      { "field": "status", "op": "in", "value": ["inbox", "todo", "doing", "waiting", "review", "deferred"] },
      { "field": "role.controller", "op": "eq", "value": "me" },
      { "field": "role.executors", "op": "excludes", "value": "me" }
    ] },
    { "id": "waiting", "title": "Жду от людей", "all": [{ "field": "status", "op": "eq", "value": "waiting" }] },
    { "id": "overdue", "title": "Просрочено", "all": [
      { "field": "status", "op": "in", "value": ["inbox", "todo", "doing", "waiting", "review", "deferred"] },
      { "field": "due", "op": "eq", "value": "overdue" },
      { "field": "involves_me", "op": "eq", "value": true }
    ], "order": "due" },
    { "id": "review", "title": "На проверке", "all": [{ "field": "status", "op": "eq", "value": "review" }] },
    { "id": "team", "title": "Команда", "all": [
      { "field": "status", "op": "in", "value": ["inbox", "todo", "doing", "waiting", "review", "deferred"] },
      { "field": "involves_me", "op": "eq", "value": false }
    ] },
    { "id": "unreported", "title": "Не учтено", "all": [
      { "field": "status", "op": "eq", "value": "done" },
      { "field": "report_missing", "op": "not_empty" }
    ] },
    { "id": "done", "title": "Готовые", "all": [{ "field": "status", "op": "in", "value": ["done", "cancelled"] }] }
  ]
}
